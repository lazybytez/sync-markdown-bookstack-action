{
    "name": "sync-markdown-bookstack-action",
    "version": "1.0.0",
    "description": "An action that syncs markdown files to a book or chapter in BookStack",
    "type": "module",
    "main": "dist/index.js",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "bundle": "rolldown --config",
        "lint": "biome check --error-on-warnings .",
        "test": "vitest run --coverage"
    },
    "keywords": [
        "bookstack",
        "markdown",
        "sync"
    ],
    "author": "Lazy Bytez <contact@lazybytez.de>",
    "license": "MIT",
    "dependencies": {
        "@actions/core": "^3.0.1",
        "axios": "^1.21.1",
        "glob": "^14.0.6"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.8",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@vitest/coverage-v8": "^5.1.1",
        "rolldown": "^1.3.3",
        "rolldown-license-plugin": "^3.0.15",
        "vitest": "^5.1.1"
    }
}
