{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
    "labels": ["C5 - dependencies"],
    "reviewers": ["team:oss-maintainers"],
    "dependencyDashboardApproval": true,
    "minimumReleaseAge": "3 days",
    "abandonmentThreshold": "2 years",
    "lockFileMaintenance": { "enabled": true },
    "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
    "packageRules": [
        { "groupName": "github actions", "matchManagers": ["github-actions"] },
        { "groupName": "vitest", "matchPackageNames": ["vitest", "@vitest/**"] },
        { "groupName": "commitlint", "matchPackageNames": ["@commitlint/**"] },
        {
            "matchUpdateTypes": ["lockFileMaintenance", "pin", "pinDigest", "replacement", "rollback"],
            "minimumReleaseAge": null
        }
    ]
}
